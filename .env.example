# Copy to .env and fill in what you need. Never commit .env.

# --- LLM (OpenAI-compatible endpoint) -------------------------------------
# Used by the compliance/safety/financial agents, the reducer summary and
# clinical-note extraction. Without a key the safety and financial agents use
# local rules and the compliance agent returns UNKNOWN.
KADO_API_KEY=
# OPENAI_API_KEY can be used instead of KADO_API_KEY.
OPENAI_API_KEY=
# Defaults to the hackathon inference gateway; point it at any OpenAI-compatible API.
KADO_BASE_URL=https://awesome.kado.so/openai/v1
KADO_MODEL=kado

# Optional: Groq, used only by the FHIR harmonizer in apps/orchestrator/gateway.py
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Service ports and A2A endpoints (defaults shown) ----------------------
GATEWAY_PORT=8000
COMPLIANCE_FASTAPI_PORT=8001
SAFETY_FASTAPI_PORT=8002
FINANCIAL_FASTAPI_PORT=8003
# Base URLs only. The gateway appends /rpc.
A2A_COMPLIANCE_URL=http://127.0.0.1:8001
A2A_SAFETY_URL=http://127.0.0.1:8002
A2A_FINANCIAL_URL=http://127.0.0.1:8003

# --- Optional Supabase (everything falls back to local files / memory) -----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Postgres connection string for the LangGraph checkpointer (also read from
# DATABASE_URL, POSTGRES_URL or SUPABASE_POSTGRES_URL). Blank = in-memory.
SUPABASE_DB_URI=

# --- Web app: only needed when the gateway is not on http://localhost:8000 --
GATEWAY_URL=
NEXT_PUBLIC_GATEWAY_URL=
